@using HouseholdTasks.ViewModels.Responsaveis

@model CadastrarAtualizarResponsavelViewModel

@{
    ViewData["Title"] = "Adicionar";
}

<h1>Adicionar</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="form-label required"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <a asp-action="Index" class="btn btn-secondary fw-bolder me-3">Voltar</a>
                <input type="submit" value="Salvar" class="btn btn-primary fw-bolder me-3" />
            </div>
        </form>
    </div>
</div>