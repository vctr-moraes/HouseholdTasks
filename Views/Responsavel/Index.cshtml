@using HouseholdTasks.ViewModels.Responsaveis

@model IEnumerable<VisualizarResponsaveisViewModel>

@{
    ViewData["Title"] = "Responsáveis";
}

<style>
    .id-responsavel {
        cursor: pointer;
    }
</style>

<div class="d-flex flex-stack flex-wrap flex-sm-nowrap">
    <h1>Responsáveis</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary fw-bolder me-3">Adicionar</a>
    </p>
</div>
<div class="card card-bordered">
    <table class="table table-hover gs-7 gy-7 gx-7">
        <tbody>
            @foreach (var item in Model) {
                <tr class="id-responsavel py-5 fw-bold border-bottom border-gray-100 fs-4" data-responsavel="@item.Id">
                    <td>
                        @Html.DisplayFor(model => item.Nome)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(".id-responsavel").click(function () {
            const id_responsavel = $(this).data('responsavel');
            window.location.href = "Detalhes/" + id_responsavel;
        });
    </script>
}